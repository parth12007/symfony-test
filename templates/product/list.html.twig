{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
    <div class="container mt-4">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Products</h1>
            <a href="{{ path('app_product_new') }}" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Create Product
            </a>
        </div>

        {# Filters #}
        <div class="card mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-2">
                        <input type="text" name="search" class="form-control" 
                               placeholder="Search..." value="{{ search }}">
                    </div>
                    <div class="col-md-2">
                        <select name="category" class="form-select">
                            <option value="">All Categories</option>
                            {% for cat in categories %}
                                <option value="{{ cat.value }}" 
                                        {% if selectedCategory == cat %}selected{% endif %}>
                                    {{ cat.value }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="min_price" class="form-control" 
                               placeholder="Min Price" value="{{ minPrice }}">
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="max_price" class="form-control" 
                               placeholder="Max Price" value="{{ maxPrice }}">
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-1"></i>Filter
                        </button>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        {% if search or selectedCategory or minPrice or maxPrice or sortBy != 'createdAt' or sortOrder != 'DESC' %}
                            <a href="{{ path('app_product_list') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Clear
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>

        {# Products Table #}
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>
                                    <a href="{{ path('app_product_list', {
                                        'sort_by': 'title',
                                        'sort_order': sortBy == 'title' and sortOrder == 'ASC' ? 'DESC' : 'ASC'
                                    }|merge(app.request.query.all|filter((v, k) => k not in ['sort_by', 'sort_order']))) }}">
                                        Title
                                        {% if sortBy == 'title' %}
                                            <i class="fas fa-sort-{{ sortOrder == 'ASC' ? 'up' : 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th>SKU</th>
                                <th>Category</th>
                                <th>
                                    <a href="{{ path('app_product_list', {
                                        'sort_by': 'priceExclVat',
                                        'sort_order': sortBy == 'priceExclVat' and sortOrder == 'ASC' ? 'DESC' : 'ASC'
                                    }|merge(app.request.query.all|filter((v, k) => k not in ['sort_by', 'sort_order']))) }}">
                                        Price
                                        {% if sortBy == 'priceExclVat' %}
                                            <i class="fas fa-sort-{{ sortOrder == 'ASC' ? 'up' : 'down' }}"></i>
                                        {% endif %}
                                    </a>
                                </th>
                                <th>Quantity</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product in pagination %}
                                <tr>
                                    <td>
                                        <img src="{{ asset('uploads/products/' ~ product.imageFilename) }}" 
                                             alt="No image" class="img-thumbnail" 
                                             style="max-width: 50px;">
                                    </td>
                                    <td>{{ product.title }}</td>
                                    <td>{{ product.sku }}</td>
                                    <td>{{ product.category.value }}</td>
                                    <td>€{{ product.priceExclVat|number_format(2) }}</td>
                                    <td>{{ product.quantity }}</td>
                                    <td>
                                        <a href="{{ path('app_product_show', {uuid: product.uuid}) }}" 
                                           class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form action="{{ path('app_product_delete', {uuid: product.uuid}) }}" 
                                              method="post" class="d-inline" 
                                              onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-product') }}">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        No products found.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-center">
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %} 